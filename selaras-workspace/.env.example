# =============================================================================
# IT Selaras Workspace — template environment
# Salin menjadi .env.local lalu isi. .env.local TIDAK boleh di-commit.
# Semua nilai ada di Supabase Dashboard > tombol "Connect" / Project Settings.
# =============================================================================

# --- Publik (boleh terlihat di browser) ---------------------------------------
# Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API Keys > Publishable key (sb_publishable_...).
# Legacy "anon" key masih diterima, tetapi dijadwalkan deprecated akhir 2026.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Rahasia (HANYA server; jangan pernah diberi prefix NEXT_PUBLIC_) ---------
# Project Settings > API Keys > Secret key (sb_secret_...). Pengganti
# SUPABASE_SERVICE_ROLE_KEY di dokumen SRS — sama-sama melewati RLS.
# Dipakai oleh: halaman status Fase 0 (dev), skrip seed/verify, Auth Admin API.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Connection string untuk `npm run db:push` (Supabase CLI).
# Connect > Session pooler (port 5432, IPv4). Direct connection hanya IPv6.
# Karakter khusus di password wajib di-percent-encode (mis. @ -> %40).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Data contoh (development) ------------------------------------------------
# Password untuk SEMUA akun demo yang dibuat `npm run db:seed` (min. 12 karakter).
SEED_DEMO_PASSWORD=
# Domain email akun demo (admin@<domain>, rina@<domain>, ...).
SEED_EMAIL_DOMAIN=selaras.test

# --- Opsional -----------------------------------------------------------------
# Hanya untuk `npm run db:types` bila SUPABASE_DB_URL tidak diisi (butuh `npx supabase login`).
# SUPABASE_PROJECT_REF=your-project-ref
